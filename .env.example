# Copy to .env and fill in what you need. This file configures the COMPOSE LAYER
# only — the shared stack and how the agent attaches to it:
#   1) the SHARED stack (postgres + litellm + ollama):
#        ./start-shared-mac.sh    /   start-shared-windows.bat
#   2) the AGENT, which joins that stack's network and reaches infrastructure by
#      name (postgres:5432, litellm:4000):
#        ./start-agent-mac.sh     /   start-agent-windows.bat
#
# Application settings for the agent itself live in src/.env/{ENV}/.env — see the
# README's Configuration section. This file never reaches the agent process
# except through docker-compose.stack.yml's explicit overrides below.
#
# .env is git-ignored. Never commit real keys.

# ── Shared Postgres ─────────────────────────────────────────────────────────
# One server, many databases. The agent creates POSTGRES_DB on first boot;
# LiteLLM's admin-UI database (LITELLM_DB) is created by the shared launcher.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pyagent
# Neutral admin database the server starts with.
SHARED_POSTGRES_DB=postgres

# ── LiteLLM gateway ─────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-1234
LITELLM_DB=litellm
# UI login; defaults to admin / the master key above.
# LITELLM_UI_USERNAME=admin
# LITELLM_UI_PASSWORD=

# Cloud provider keys are OPTIONAL when running the default local models.
# Set only the ones matching the model you select in litellm/config.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ── Local models (Ollama), part of the SHARED stack ──────────────────────────
#   macOS   : uses HOST Ollama on the Metal GPU via an nginx proxy. Pull models
#             on the host:  ollama pull qwen2.5:7b
#   Win/Lin : runs Ollama in a container and auto-pulls OLLAMA_DEFAULT_MODEL.
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_PORT=11434
# (Windows/Linux) Point at an existing Ollama store to skip re-downloading.
# Leave unset to use the shared_ollama_data named volume.
# OLLAMA_MODELS_PATH=

# ── Host port mappings (override to avoid clashes) ───────────────────────────
AGENT_PORT=8000
LITELLM_PORT=4000
SHARED_PG_PORT=5432

# ── Agent workspace mount ───────────────────────────────────────────────────
# A folder on YOUR machine mounted at /workspaces, holding playbooks the agent is
# allowed to read in place. Absolute path recommended:
#   Windows     : C:/git/workflows
#   macOS/Linux : /Users/you/git/workflows
# WORKSPACES_HOST_DIR=./workspaces

# ── Shared network selection (advanced) ─────────────────────────────────────
# The launchers default to jb-ai-shared-net. Set this only to attach the
# orchestrator to a differently named external network.
# SHARED_NET=jb-ai-shared-net
