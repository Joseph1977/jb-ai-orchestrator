# Docker environment configuration
Environment=docker
Region=USC1
ServiceName=jb-ai-orchestrator-service
Service=MAINAGENT

MAX_TOOL_CALLS=10
# Phase 3 lifecycle close/heartbeat (defaults: interval 5, stale 300, close wait 10)
# RUN_HEARTBEAT_INTERVAL_SEC=5
# RUN_HEARTBEAT_STALE_SEC=300
# CLOSE_WAIT_TIMEOUT_SEC=10

# Orchestrator / local coding tools — see docs/ORCHESTRATOR.md
# WORKSPACES_ROOT=/var/tmp/jb-agent-workspaces
#
# Local workflow folder the orchestrator can access:
#   docker-compose.yml mounts a host folder to /workspaces (set the host path via
#   WORKSPACES_HOST_DIR when you run `docker compose up`, e.g.
#   `WORKSPACES_HOST_DIR=c:/git/workflows docker compose up`, or export
#   it first). In-place binding is enabled below and restricted to /workspaces so
#   the orchestrator/local tools may read workflow files. For optional shared_folder
#   output bindings. Default false below; callers that send non-null output
#   must opt in to OUTPUT_BINDINGS_ENABLED=true in their own compose/env.
#   When enabled, WORKSPACE_ALLOWED_ROOTS must cover every input
#   and output mount (comma-separated absolute container paths). Local shared_folder
#   output needs no credentials.
ALLOW_INPLACE_WORKSPACE=true
WORKSPACE_ALLOWED_ROOTS=/workspaces
OUTPUT_BINDINGS_ENABLED=false
OUTPUT_READ_MAX_BYTES=5242880
OUTPUT_WRITE_MAX_BYTES=5242880
OUTPUT_LIST_MAX_ENTRIES=1000
AZURE_BLOB_TIMEOUT_SEC=60
LOCAL_TOOLS_ENABLED=true
LOCAL_TOOLS_NAMESPACE=local
FILTER_MCP_TOOLS_CONFLICTING_WITH_LOCAL=true
LOCAL_SHELL_ENABLED=true
LOCAL_SHELL_TIMEOUT_SEC=60
LOCAL_SHELL_MAX_OUTPUT_BYTES=100000
CONTEXT_COMPACTION_ENABLED=true
TOOL_RESULT_OFFLOAD_CHARS=8000
CONTEXT_COMPACTION_CHARS=120000
CONTEXT_COMPACTION_KEEP_RECENT_TOOL_MSGS=8
SUBAGENT_ENABLED=true
SUBAGENT_MAX_TOOL_CALLS=8
SUBAGENT_MAX_DEPTH=2
LLM_STREAMING_ENABLED=true

# Database — points to Postgres installed on your host machine
DATABASE_URL=postgresql+asyncpg://postgres:__POSTGRES_PASSWORD__@host.docker.internal:5432/pyagent

# MCP Server Configuration
# Use host.docker.internal to reach services running on your host machine.
MCP_SERVER_URLS=[{"name": "local-mcp", "url": "http://host.docker.internal:8001/mcp"}]

# LiteLLM Configuration
# Use host.docker.internal to reach LiteLLM running on your host machine.
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=__LITELLM_API_KEY__
LITELLM_REQUEST_TIMEOUT_IN_SEC=300
LITELLM_DROP_PARAMS=True

# Logging Configuration
General_LogFolder=./Logs
Logging_LogLevel_Default=Information

# Swagger Configuration
SwaggerBasePath=
