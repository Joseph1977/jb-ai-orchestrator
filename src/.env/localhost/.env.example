# Copy to src/.env/localhost/.env and fill in the marked values.
Environment=localhost
Region=USC1
ServiceName=jb-ai-orchestrator-service
Service=MAINAGENT

# --- Required ---------------------------------------------------------------
# Must use the postgresql+asyncpg:// scheme, not plain postgresql://
DATABASE_URL=postgresql+asyncpg://postgres:__POSTGRES_PASSWORD__@localhost:5432/pyagent

# At least one MCP server is required. Both supported forms take JSON objects
# with a name and a url; the name becomes the tool suffix (search_google).
# Form 1 — JSON array (recommended):
MCP_SERVER_URLS=[{"name": "local", "url": "http://localhost:8001/mcp"}]
# Form 2 — numbered objects, discovered from _1 upwards until the first gap:
# MCP_SERVER_URL_1={"name": "local", "url": "http://localhost:8001/mcp"}
# MCP_SERVER_URL_2={"name": "google", "url": "https://mcp.google.com/mcp"}

LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=__LITELLM_API_KEY__
LITELLM_REQUEST_TIMEOUT_IN_SEC=300
LITELLM_DROP_PARAMS=True

# --- Agent ------------------------------------------------------------------
MAX_TOOL_CALLS=10
# Stale resume claim recovery: PENDING holds older than this (seconds) are restored
# to AWAITING_RESPONSE before fresh runs/resumes (default: 300)
# RESUME_CLAIM_TIMEOUT_SEC=300
# Phase 3: active run heartbeat interval (seconds, default: 5)
# RUN_HEARTBEAT_INTERVAL_SEC=5
# Phase 3: heartbeat age before an active/closing run is treated as stale (default: 300)
# RUN_HEARTBEAT_STALE_SEC=300
# Phase 3: close wait/poll budget before returning closing (seconds, default: 10)
# CLOSE_WAIT_TIMEOUT_SEC=10

# Orchestrator (folder execution) — see docs/ORCHESTRATOR.md
# Root dir for isolated per-execution workspaces (default: <tmp>/jb-agent-workspaces)
# WORKSPACES_ROOT=/var/tmp/jb-agent-workspaces
# Allow inPlace=true to run on a local path without copying it (default: false)
ALLOW_INPLACE_WORKSPACE=false
# Phase 2: allow a non-null output binding (default: false). When true, list every
# input and output shared mount in WORKSPACE_ALLOWED_ROOTS (comma-separated container paths).
OUTPUT_BINDINGS_ENABLED=false
# Durable output read/write byte caps and per-list page cap
OUTPUT_READ_MAX_BYTES=5242880
OUTPUT_WRITE_MAX_BYTES=5242880
OUTPUT_LIST_MAX_ENTRIES=1000
# Per-operation Azure Blob timeout, seconds
AZURE_BLOB_TIMEOUT_SEC=60
# Timeout for `git clone` / archive downloads, seconds (default: 120)
GIT_CLONE_TIMEOUT_SEC=120
# Soft cap on provisioned workspace size in MB; 0 disables (default: 0)
MAX_WORKSPACE_MB=0
# Expose built-in in-process coding tools (fs/search/shell/git/ask_user) (default: true)
LOCAL_TOOLS_ENABLED=true
# Suffix marking local tools, e.g. read_file_local (default: local)
LOCAL_TOOLS_NAMESPACE=local
# Drop remote MCP tools whose base name collides with a local built-in (default: true)
FILTER_MCP_TOOLS_CONFLICTING_WITH_LOCAL=true
# Shell tool (execute_local): cwd=workspace; not a full OS jail (default: true)
LOCAL_SHELL_ENABLED=true
LOCAL_SHELL_TIMEOUT_SEC=60
LOCAL_SHELL_MAX_OUTPUT_BYTES=100000
# Context compaction: offload oversized tool results + shrink older tool msgs
CONTEXT_COMPACTION_ENABLED=true
TOOL_RESULT_OFFLOAD_CHARS=8000
CONTEXT_COMPACTION_CHARS=120000
CONTEXT_COMPACTION_KEEP_RECENT_TOOL_MSGS=8
# Subagents (task_local) + AG-UI token streaming
SUBAGENT_ENABLED=true
SUBAGENT_MAX_TOOL_CALLS=8
SUBAGENT_MAX_DEPTH=2
LLM_STREAMING_ENABLED=true
# Project hooks (.cursor/hooks.json / Claude) — see docs/ORCHESTRATOR.md
HOOKS_ENABLED=true
HOOKS_FAIL_CLOSED=false
HOOKS_TIMEOUT_SEC=30
HOOKS_MAX_OUTPUT_BYTES=100000
# Path / shell policy (empty lists = resolve_within-only + no shell regex filters)
PATH_POLICY_ENABLED=true
# PATH_DENYLIST=.env,**/*.pem,**/.ssh/**
# PATH_ALLOWLIST=
# WORKSPACE_ALLOWED_ROOTS=/app/sessions,/workspaces
# Example binding deploy: ALLOW_INPLACE_WORKSPACE=true, OUTPUT_BINDINGS_ENABLED=true,
# WORKSPACE_ALLOWED_ROOTS covering caller workflow and output shared_folder mounts.
# SHELL_COMMAND_DENYLIST=rm\s+-rf\s+/
# SHELL_COMMAND_ALLOWLIST=
# Multimodal image/PDF reads (LiteLLM content parts on next turn)
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_BYTES=5242880
# MULTIMODAL_MODEL_ALLOWLIST=
# MULTIMODAL_MODEL_DENYLIST=gpt-3.5,gpt-3.5-turbo,text-embedding,embedding,whisper,tts,davinci,babbage,curie
# MULTIMODAL_VISION_MARKERS=gpt-4o,gpt-4.1,gpt-4-turbo,gpt-5,o1,o3,o4,claude-3,claude-4,claude-sonnet,claude-opus,claude-haiku,gemini,gemini-1.5,gemini-2,vision

# --- Logging / docs ---------------------------------------------------------
General_LogFolder=./Logs
Logging_LogLevel_Default=Information
SwaggerBasePath=

# Notes:
# - Every tool is suffixed with its server name (search_google, weather_general),
#   whether or not the base name collides across servers.
# - A server configured without a name is reported as "default".
# - If one server is unreachable, tools from the others remain available.
# - Tool execution logs include the server name and URL for traceability.
