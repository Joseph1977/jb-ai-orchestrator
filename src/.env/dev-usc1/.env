# Development environment configuration
Environment=DEV
Region=USC1
ServiceName=jb-ai-orchestrator-service
Service=MAINAGENT

MAX_TOOL_CALLS=10
# MCP Server Configuration - Multiple servers support
# Option 1: Named objects format (recommended)
MCP_SERVER_URLS="[{\"name\": \"general\", \"url\": \"https://private-gateway-dev-usc1.benraz.com/mcp-server/mcp\"}]"

# LiteLLM Configuration  
LITELLM_BASE_URL=https://private-gateway-dev-usc1.benraz.com/litellm-service
LITELLM_API_KEY=__LITELLM_API_KEY__
LITELLM_REQUEST_TIMEOUT_IN_SEC=300
LITELLM_DROP_PARAMS=True

# Logging Configuration
General_LogFolder=./Logs
Logging_LogLevel_Default=Information

# Swagger Configuration
SwaggerBasePath=/jb-ai-orchestrator-service
