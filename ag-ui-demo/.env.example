VITE_MAIN_AGENT_BASE_URL=http://localhost:8000
VITE_THREAD_ID=ag-ui-demo-thread

# Optional Phase 4 binding example (container paths under your shared mount).
# Omit VITE_BINDING_INPUT_URI for plain chat (no bindings). Workflow input is required
# when using bindings; VITE_BINDING_OUTPUT_URI alone is invalid demo configuration.
# VITE_BINDING_INPUT_URI=/workspaces/my-playbook
# VITE_BINDING_INPUT_RELATIVE_PATH=.
# VITE_BINDING_OUTPUT_URI=/workspaces/my-output
# VITE_BINDING_OUTPUT_RELATIVE_PATH=.

# Close helper retry (POST /api/ag-ui/threads/{threadId}/close on 202 closing).
# Invalid values clamp to defaults (5 attempts, 500ms backoff; max 20 attempts).
# VITE_CLOSE_RETRY_MAX_ATTEMPTS=5
# VITE_CLOSE_RETRY_BACKOFF_MS=500
